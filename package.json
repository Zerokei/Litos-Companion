{
  "name": "litos-companion",
  "version": "0.2.0",
  "private": true,
  "description": "Heading controls, Mermaid ELK support, Zen mode, and accent color settings for Litos.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "0.2.0",
    "mermaid": "11.16.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
